# ── Server ────────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# Port the Express API listens on (default: 3001)
PORT=3001

# URL of the frontend (used for CORS). In dev this is the Vite dev server.
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Email address that is automatically granted admin access on first login.
ADMIN_EMAIL=your-admin-email@example.com


# ── Database ───────────────────────────────────────────────────────────────────
# Leave blank locally — defaults to ./locallink.db in the project root.
# In production point this to a persistent disk:
#   DB_PATH=/data/locallink.db       (Fly.io)
#   DB_PATH=/var/data/locallink.db   (Railway)
# DB_PATH=


# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
# Used to send email-verification and password-reset links.
# EMAIL_PASS MUST be a Gmail App Password, NOT your regular Gmail password.
#
# How to get an App Password:
#   1. myaccount.google.com → Security
#   2. Enable 2-Step Verification
#   3. App Passwords → generate one for "Mail"
#   4. Paste the 16-character code below.
#
# If you don't set these, the server still runs but email features will be disabled.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="LocalLink" <your-gmail@gmail.com>
