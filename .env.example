# ── Server ────────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens.
# WARNING: if unset, falls back to the hardcoded string "locallink-dev-secret-change-in-production".
# Always set this to a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-this-to-a-long-random-secret

# Port the Express API listens on (default: 3001)
PORT=3001

# URL of the frontend (used for CORS). In dev this is the Vite dev server.
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Email address that is automatically granted admin access.
# WARNING: if unset, falls back to the hardcoded "linklocal2@gmail.com" — always set this.
ADMIN_EMAIL=your-admin-email@example.com


# ── Database ───────────────────────────────────────────────────────────────────
# Leave blank locally — defaults to ./locallink.db in the project root.
# In production point this to a persistent disk:
#   DB_PATH=/data/locallink.db       (Fly.io)
#   DB_PATH=/var/data/locallink.db   (Railway)
# DB_PATH=


# ── Email (Brevo / Sendinblue) ─────────────────────────────────────────────────
# LocalLink sends email via the Brevo REST API (https://brevo.com).
# All transactional email (verification, password reset, reminders) requires this key.
# If unset, email features are disabled AND new users are auto-verified without confirmation.
#
# How to get an API key:
#   1. app.brevo.com → Account → SMTP & API → API Keys → Generate a new API key
#   2. Paste the key below.
BREVO_API_KEY=your-brevo-api-key-here

# "From" address shown in outgoing emails. Must be a verified sender in your Brevo account.
EMAIL_FROM=your-sender@example.com
